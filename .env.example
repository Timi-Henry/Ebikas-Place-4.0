# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Signing secret for the direct Clerk endpoint at /api/webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

# Long random bearer secret used by scheduled maintenance routes.
CRON_SECRET=replace_with_at_least_32_random_characters

# Public site URL used for SEO metadata, sitemap, robots, and same-origin checks.
# Use localhost here; set the final HTTPS custom domain in the production host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional local/test catalog mode. Ignored in production and never merged with database inventory.
ENABLE_SAMPLE_CATALOG=false

# Comma-separated Clerk user IDs or email addresses allowed into /admin and product mutations.
ADMIN_IDENTIFIERS=user_abc123,owner@example.com

# MongoDB Atlas or replica-set connection string. Transactions require Atlas or another replica set.
# Examples: mongodb+srv://... or mongodb://host-a,host-b,host-c/...?replicaSet=...
MONGODB_URI=mongodb://localhost:27017/ebikas_place
MONGODB_DB=ebikas_place

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
CLOUDINARY_UPLOAD_FOLDER=ebikas-place/products

# Resend transactional email. Customer delivery requires a domain you own and
# have verified in Resend; the resend.dev test sender can only email your own account.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=orders@yourdomain.com
RESEND_FROM_NAME=Ebika's Place
ORDER_ADMIN_EMAIL=ebikasplace@gmail.com

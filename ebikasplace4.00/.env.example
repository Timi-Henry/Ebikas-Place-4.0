# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Public site URL used for SEO metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Comma-separated Clerk user IDs or email addresses allowed into /admin and product mutations.
ADMIN_IDENTIFIERS=user_abc123,owner@example.com

# MongoDB regular connection string. Use mongodb:// shard hosts, not mongodb+srv://.
# Example:
# MONGODB_URI=mongodb://user:password@cluster0-shard-00-00.example.mongodb.net:27017,cluster0-shard-00-01.example.mongodb.net:27017,cluster0-shard-00-02.example.mongodb.net:27017/ebikas_place?ssl=true&replicaSet=atlas-abc123-shard-0&authSource=admin&retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ebikas_place
MONGODB_DB=ebikas_place

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
CLOUDINARY_UPLOAD_FOLDER=ebikas-place/products

{
  "name": "ebikas-place",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed:amazon-project-catalog": "node --env-file=.env.local scripts/seed-amazon-project-catalog.mjs --apply",
    "lint": "eslint app components lib tests middleware.ts instrumentation.ts next.config.ts vitest.config.ts eslint.config.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@clerk/backend": "^3.8.0",
    "@clerk/nextjs": "latest",
    "@vercel/queue": "^0.4.0",
    "cloudinary": "latest",
    "lucide-react": "latest",
    "mongodb": "latest",
    "next": "15.5.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "15.5.23",
    "typescript": "latest",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
